{
    "name": "bensomething/craft-discontent",
    "description": "Filtering and slideout editing for fields and entry types.",
    "type": "craft-plugin",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "plugin",
        "fields",
        "entry types",
        "admin"
    ],
    "support": {
        "issues": "https://github.com/bensomething/craft-discontent/issues",
        "source": "https://github.com/bensomething/craft-discontent"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.10"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "bensomething\\discontent\\": "src/"
        }
    },
    "extra": {
        "handle": "discontent",
        "name": "Discontent",
        "developer": "Ben Smith",
        "developerUrl": "https://bensomething.com",
        "documentationUrl": "https://github.com/bensomething/craft-discontent",
        "changelogUrl": "https://raw.githubusercontent.com/bensomething/craft-discontent/develop/CHANGELOG.md",
        "class": "bensomething\\discontent\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "test:slideout": "@php tests/slideout-assumptions.php"
    }
}
