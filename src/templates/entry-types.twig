{% extends "discontent/_layout" %}
{% import "_includes/forms" as forms %}

{% set selectedNavItem = 'entry-types' %}
{% set selectedSubnavItem = 'entry-types' %}
{% set crumbs = [
    { label: craft.app.plugins.getPlugin('discontent').name, url: url('discontent') },
    { label: "Entry Types"|t('app'), url: url('discontent/entry-types') },
] %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}
{% do view.registerTranslations('app', ['Handle', 'Entry Type', 'Used by', 'No usages', 'No results.', 'Search']) %}

{% block actionButton %}
    {% if craft.app.config.general.allowAdminChanges %}
        <a href="{{ url('settings/entry-types/new') }}" class="btn submit add icon">{{ "New entry type"|t('app') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    <div id="ct-toolbar" class="toolbar flex flex-nowrap">
        <div class="flex-grow texticon search icon clearable">
            <input type="text" id="ct-search" class="text fullwidth" autocomplete="off"
                   value="{{ initialSearch ?? '' }}"
                   placeholder="{{ 'Search'|t('app') }}" aria-label="{{ 'Search'|t('app') }}">
        </div>
        {{ forms.select({
            id: 'ct-usage',
            options: [
                { label: 'All entry types'|t('discontent'), value: '' },
                { label: 'Section entries'|t('discontent'), value: 'section' },
                { label: 'Matrix entries'|t('discontent'), value: 'matrix' },
                { label: 'CKEditor entries'|t('discontent'), value: 'ckeditor' },
            ],
            value: initialFilter ?? '',
            inputAttributes: { aria: { label: 'Usage'|t('discontent') } },
        }) }}
        {# Omitted entirely when “Show all” is the only view that applies. #}
        {% if views is not empty %}
            {{ forms.select({
                id: 'ct-view',
                options: views,
                value: initialView ?? '',
                inputAttributes: { aria: { label: 'View'|t('discontent') } },
            }) }}
        {% endif %}
    </div>

    <div id="ct-entry-types-table"></div>
{% endblock %}

{% js %}
    (() => {
        const flag = Craft.Discontent.flag({{ checkIcon|json_encode|raw }});

        const columns = [
            { name: 'chip', title: Craft.t('app', 'Entry Type'), sortField: true },
            { name: '__slot:handle', title: Craft.t('app', 'Handle'), sortField: true },
            {
                name: 'usages',
                title: Craft.t('app', 'Used by'),
                callback: (value) => value || `<i class="light">${Craft.t('app', 'No usages')}</i>`,
            },
            { name: 'slug', title: Craft.t('discontent', 'Slug'), callback: flag },
            { name: 'status', title: Craft.t('discontent', 'Status'), callback: flag },
        ];

        new Craft.Discontent.FilterTable({
            columns: columns,
            tableContainer: '#ct-entry-types-table',
            endpoint: 'discontent/entry-types/table-data',
            emptyMessage: Craft.t('discontent', 'No entry types match these filters.'),
            searchSelector: '#ct-search',
            filterSelector: '#ct-usage',
            filterParam: 'usage',
            viewSelector: '#ct-view',
            viewParam: 'view',
            editAction: 'entry-types/edit',
            editParam: 'entryTypeId',
            editIdRegex: /\/entry-types\/(\d+)/,
            readOnly: {{ craft.app.config.general.allowAdminChanges ? 'false' : 'true' }},
            {% if craft.app.config.general.allowAdminChanges %}
            deleteAction: 'entry-types/delete',
            deleteConfirmationMessage: Craft.t('app', 'Are you sure you want to delete “{name}” and all entries of that type?'),
            {% endif %}
        });
    })();
{% endjs %}
