{% extends "content-tools/_layout" %}
{% import "_includes/forms" as forms %}

{% set selectedNavItem = 'entry-types' %}
{% set selectedSubnavItem = 'entry-types' %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}
{% do view.registerTranslations('app', ['Handle', 'Entry Type', 'Used by', 'No usages', 'No results.', 'Search']) %}

{% block actionButton %}
    {% if craft.app.config.general.allowAdminChanges %}
        <a href="{{ url('settings/entry-types/new') }}" class="btn submit add icon">{{ "New entry type"|t('app') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    <div id="ct-toolbar" class="toolbar flex flex-nowrap">
        <div class="flex-grow texticon search icon clearable">
            <input type="text" id="ct-search" class="text fullwidth" autocomplete="off"
                   placeholder="{{ 'Search'|t('app') }}" aria-label="{{ 'Search'|t('app') }}">
        </div>
        {{ forms.select({
            id: 'ct-usage',
            options: [
                { label: 'All entry types'|t('content-tools'), value: '' },
                { label: 'Entries'|t('content-tools'), value: 'section' },
                { label: 'Matrix entries'|t('content-tools'), value: 'field' },
            ],
        }) }}
        {% if showUnused ?? false %}
            <div class="flex flex-nowrap ct-unused-toggle">
                {{ forms.lightswitch({ id: 'ct-unused' }) }}
                <label for="ct-unused">{{ 'Unused'|t('content-tools') }}</label>
            </div>
        {% endif %}
    </div>

    <div id="ct-entry-types-table"></div>
{% endblock %}

{% js %}
    (() => {
        const columns = [
            { name: 'chip', title: Craft.t('app', 'Entry Type'), sortField: true },
            { name: '__slot:handle', title: Craft.t('app', 'Handle'), sortField: true },
            {
                name: 'usages',
                title: Craft.t('app', 'Used by'),
                callback: (value) => value || `<i class="light">${Craft.t('app', 'No usages')}</i>`,
            },
        ];

        new Craft.ContentTools.FilterTable({
            columns: columns,
            tableContainer: '#ct-entry-types-table',
            endpoint: 'content-tools/entry-types/table-data',
            emptyMessage: Craft.t('content-tools', 'No entry types match these filters.'),
            searchSelector: '#ct-search',
            filterSelector: '#ct-usage',
            filterParam: 'usage',
            unusedSelector: '#ct-unused',
            editAction: 'entry-types/edit',
            editParam: 'entryTypeId',
            editIdRegex: /\/entry-types\/(\d+)/,
            {% if craft.app.config.general.allowAdminChanges %}
            deleteAction: 'entry-types/delete',
            deleteConfirmationMessage: Craft.t('app', 'Are you sure you want to delete “{name}” and all entries of that type?'),
            {% endif %}
        });
    })();
{% endjs %}
