{% extends "_layouts/cp" %}

{% do view.registerAssetBundle('bensomething\\contenttools\\web\\assets\\ContentToolsAsset') %}

{# "Content Tools" stays the page title across every subpage; the current page
   is indicated by the highlighted sidebar item. #}
{% set title = "Content Tools"|t('content-tools') %}
{% set crumbs = [
    { label: "Settings"|t('app'), url: url('settings') },
] %}

{% set navItems = {
    'entry-types': { label: "Entry Types"|t('content-tools'), url: url('content-tools/entry-types') },
    'fields': { label: "Fields"|t('content-tools'), url: url('content-tools/fields') },
    'settings': { label: "Settings"|t('content-tools'), url: url('content-tools/settings') },
} %}

{% block sidebar %}
    {% include "_includes/nav" with {
        label: "Content Tools"|t('content-tools'),
        items: navItems,
        selectedItem: selectedNavItem ?? null,
    } only %}
{% endblock %}
