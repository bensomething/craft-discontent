{% extends "_layouts/cp" %}

{% do view.registerAssetBundle('bensomething\\discontent\\web\\assets\\DiscontentAsset') %}

{# The admin-defined plugin name stays the page title across every subpage; the
   current page is shown by the highlighted sidebar item. Each page sets its own
   crumbs ("<name> › <page>"). #}
{% set pluginName = craft.app.plugins.getPlugin('discontent').name %}
{% set title = pluginName %}

{% set navItems = {
    'entry-types': { label: "Entry Types"|t('discontent'), url: url('discontent/entry-types') },
    'fields': { label: "Fields"|t('discontent'), url: url('discontent/fields') },
    'settings': { label: "Settings"|t('discontent'), url: url('discontent/settings') },
} %}

{% block sidebar %}
    {% include "_includes/nav" with {
        label: pluginName,
        items: navItems,
        selectedItem: selectedNavItem ?? null,
    } only %}
{% endblock %}
