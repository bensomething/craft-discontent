{% extends "discontent/_layout" %}
{% import "_includes/forms" as forms %}

{% set selectedNavItem = 'sections' %}
{% set selectedSubnavItem = 'sections' %}
{% set crumbs = [
    { label: craft.app.plugins.getPlugin('discontent').name, url: url('discontent') },
    { label: "Sections"|t('app'), url: url('discontent/sections') },
] %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}
{% do view.registerTranslations('app', ['Handle', 'Name', 'Type', 'Entry Types', 'No results.', 'Search']) %}

{% block actionButton %}
    {% if craft.app.config.general.allowAdminChanges %}
        <a href="{{ url('settings/sections/new') }}" class="btn submit add icon">{{ "New section"|t('app') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    <div id="ct-toolbar" class="toolbar flex flex-nowrap">
        <div class="flex-grow texticon search icon clearable">
            <input type="text" id="ct-search" class="text fullwidth" autocomplete="off"
                   value="{{ initialSearch ?? '' }}"
                   placeholder="{{ 'Search'|t('app') }}" aria-label="{{ 'Search'|t('app') }}">
        </div>
        {# Omitted entirely when every section is of the same type. #}
        {% if sectionTypes is not empty %}
            {{ forms.select({
                id: 'ct-type',
                options: [{ label: 'All section types'|t('discontent'), value: '' }]|merge(sectionTypes),
                value: initialFilter ?? '',
                inputAttributes: { aria: { label: 'Section type'|t('discontent') } },
            }) }}
        {% endif %}
        {# Likewise when they’re all routed, or none of them are. #}
        {% if views is not empty %}
            {{ forms.select({
                id: 'ct-view',
                options: views,
                value: initialView ?? '',
                inputAttributes: { aria: { label: 'View'|t('discontent') } },
            }) }}
        {% endif %}
    </div>

    <div id="ct-sections-table"></div>
{% endblock %}

{% js %}
    (() => {
        const columns = [
            { name: '__slot:title', title: Craft.t('app', 'Name'), sortField: true },
            { name: '__slot:handle', title: Craft.t('app', 'Handle'), sortField: true },
            { name: 'type', title: Craft.t('app', 'Type'), sortField: true },
            { name: 'entryTypes', title: Craft.t('app', 'Entry Types') },
            {
                name: 'urls',
                title: Craft.t('discontent', 'URLs'),
                callback: (value) => value || `<i class="light">${Craft.t('discontent', 'No URLs')}</i>`,
            },
            {
                name: 'versioning',
                title: Craft.t('app', 'Versioning'),
                callback: Craft.Discontent.flag({{ checkIcon|json_encode|raw }}),
            },
        ];

        new Craft.Discontent.FilterTable({
            columns: columns,
            tableContainer: '#ct-sections-table',
            endpoint: 'discontent/sections/table-data',
            emptyMessage: Craft.t('discontent', 'No sections match these filters.'),
            searchSelector: '#ct-search',
            filterSelector: '#ct-type',
            filterParam: 'type',
            viewSelector: '#ct-view',
            viewParam: 'view',
            editAction: 'sections/edit-section',
            editParam: 'sectionId',
            editIdRegex: /\/sections\/(\d+)/,
            readOnly: {{ craft.app.config.general.allowAdminChanges ? 'false' : 'true' }},
            {% if craft.app.config.general.allowAdminChanges %}
            deleteAction: 'sections/delete-section',
            deleteConfirmationMessage: Craft.t('app', 'Are you sure you want to delete “{name}” and all its entries?'),
            {% endif %}
        });
    })();
{% endjs %}
