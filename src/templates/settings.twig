{% extends "discontent/_layout" %}
{% import "_includes/forms" as forms %}

{% set selectedNavItem = 'settings' %}
{% set selectedSubnavItem = 'settings' %}
{% set crumbs = [
    { label: craft.app.plugins.getPlugin('discontent').name, url: url('discontent') },
    { label: "Settings"|t('app'), url: url('discontent/settings') },
] %}

{# Full-page form → Save button in the top-right header + Cmd/Ctrl-S shortcut. #}
{% set fullPageForm = not readOnly %}

{# Read-only: render Craft’s native settings notice (the grey content-notice box
   in a pane-header, same as Craft’s own plugin settings screens) via the CP
   layout’s contentNotice slot, rather than hand-placing it in the content. #}
{% block contentNotice %}
    {% if readOnly %}{{ readOnlyNotice() }}{% endif %}
{% endblock %}

{# Page-scoped: tighten the content pane’s vertical padding so the short form
   doesn’t float in dead space. In read-only the pane-header notice bleeds off
   the pane’s top padding, so keep the top standard there (only trim the bottom)
   — otherwise the header’s negative margin over-pulls and detaches. #}
{% css %}
    #main-content > .content-pane,
    #main-content .content-pane {
        {% if readOnly %}
        padding-block-end: var(--m);
        {% else %}
        padding-block: var(--m);
        {% endif %}
    }
{% endcss %}

{% block content %}
    {{ actionInput('plugins/save-plugin-settings') }}
    {{ hiddenInput('pluginHandle', 'discontent') }}
    {{ redirectInput('discontent/settings') }}

    {{ forms.textField({
        label: "Plugin name"|t('discontent'),
        instructions: "The public-facing name of the plugin."|t('discontent'),
        id: 'pluginName',
        name: 'settings[pluginName]',
        value: settings.pluginName,
        placeholder: 'Discontent',
        autofocus: true,
        disabled: readOnly,
    }) }}

    {{ forms.lightswitchField({
        label: "Replace native pages"|t('discontent'),
        instructions: "When on, Settings → Fields and Entry Types use the enhanced filtering pages. Turn off to use Craft’s native pages."|t('discontent'),
        id: 'overrideNativePages',
        name: 'settings[overrideNativePages]',
        on: settings.overrideNativePages,
        disabled: readOnly,
    }) }}

    {{ forms.lightswitchField({
        label: "Show in main navigation"|t('discontent'),
        instructions: "Adds a nav item to the main control-panel nav, linking to the Fields and Entry Types pages."|t('discontent'),
        id: 'showInMainNav',
        name: 'settings[showInMainNav]',
        on: settings.showInMainNav,
        toggle: 'defaultView-container',
        disabled: readOnly,
    }) }}

    <div id="defaultView-container"{% if not settings.showInMainNav %} class="hidden"{% endif %}>
        {{ forms.selectField({
            label: "Default view"|t('discontent'),
            instructions: "Which page the main-nav item opens."|t('discontent'),
            id: 'defaultView',
            name: 'settings[defaultView]',
            options: [
                { label: "Entry Types"|t('discontent'), value: 'entry-types' },
                { label: "Fields"|t('discontent'), value: 'fields' },
            ],
            value: settings.defaultView,
            disabled: readOnly,
        }) }}
    </div>
{% endblock %}
