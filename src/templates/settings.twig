{% extends "content-tools/_layout" %}
{% import "_includes/forms" as forms %}

{% set title = "Content Tools"|t('content-tools') %}
{% set crumbs = [
    { label: "Settings"|t('app'), url: url('settings') },
    { label: "Plugins"|t('app'), url: url('settings/plugins') },
] %}

{% block content %}
  <div id="ct-settings">
    {% if readOnly %}
        <div class="pane">
            <p class="light">{{ "Administrative changes are disabled in this environment, so these settings can’t be edited here."|t('content-tools') }}</p>
        </div>
    {% endif %}

    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('plugins/save-plugin-settings') }}
        {{ hiddenInput('pluginHandle', 'content-tools') }}
        {{ redirectInput('settings/plugins/content-tools') }}

        {{ forms.lightswitchField({
            label: "Replace native pages"|t('content-tools'),
            instructions: "When on, Settings → Fields (and Entry Types, once available) use the enhanced filtering pages. Turn off to use Craft’s native pages."|t('content-tools'),
            id: 'overrideNativePages',
            name: 'settings[overrideNativePages]',
            on: settings.overrideNativePages,
            disabled: readOnly,
        }) }}

        {{ forms.lightswitchField({
            label: "Show in main navigation"|t('content-tools'),
            instructions: "Adds a “Content Tools” item to the main control-panel nav, linking to the Fields and Entry Types pages. Off by default."|t('content-tools'),
            id: 'showInMainNav',
            name: 'settings[showInMainNav]',
            on: settings.showInMainNav,
            disabled: readOnly,
        }) }}

        {% if not readOnly %}
            <div class="buttons">
                <button type="submit" class="btn submit">{{ "Save"|t('app') }}</button>
            </div>
        {% endif %}
    </form>
  </div>
{% endblock %}
