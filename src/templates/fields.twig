{% extends "discontent/_layout" %}
{% import "_includes/forms" as forms %}

{% set selectedNavItem = 'fields' %}
{% set selectedSubnavItem = 'fields' %}
{% set crumbs = [
    { label: craft.app.plugins.getPlugin('discontent').name, url: url('discontent') },
    { label: "Fields"|t('app'), url: url('discontent/fields') },
] %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}
{% do view.registerTranslations('app', ['Handle', 'Name', 'Type', 'Used by', 'No usages', 'No results.', 'Search']) %}

{% block actionButton %}
    {% if craft.app.config.general.allowAdminChanges %}
        <a href="{{ url('settings/fields/new') }}" class="btn submit add icon">{{ "New field"|t('app') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    <div id="ct-toolbar" class="toolbar flex flex-nowrap">
        <div class="flex-grow texticon search icon clearable">
            <input type="text" id="ct-search" class="text fullwidth" autocomplete="off"
                   value="{{ initialSearch ?? '' }}"
                   placeholder="{{ 'Search'|t('app') }}" aria-label="{{ 'Search'|t('app') }}">
        </div>
        {{ forms.select({
            id: 'ct-type',
            options: [{ label: 'All field types'|t('discontent'), value: '' }]|merge(fieldTypes),
            value: initialFilter ?? '',
        }) }}
        {% if showUnused ?? false %}
            <div class="flex flex-nowrap ct-unused-toggle">
                {{ forms.lightswitch({ id: 'ct-unused', on: initialUnused ?? false }) }}
                <label for="ct-unused">{{ 'Unused'|t('discontent') }}</label>
            </div>
        {% endif %}
    </div>

    <div id="ct-fields-table"></div>
{% endblock %}

{% js %}
    (() => {
        const columns = [
            { name: '__slot:title', title: Craft.t('discontent', 'Name'), sortField: true },
            { name: '__slot:handle', title: Craft.t('app', 'Handle'), sortField: true },
            {
                name: 'type',
                title: Craft.t('app', 'Type'),
                sortField: true,
                callback: (value) => {
                    let label = '<div class="flex flex-nowrap gap-s">' +
                        `<div class="cp-icon small">${value.icon}</div>`;
                    label += value.isMissing
                        ? `<span class="error">${value.label}</span>`
                        : `<span>${value.label}</span>`;
                    return label + '</div>';
                },
            },
            {
                name: 'usages',
                title: Craft.t('app', 'Used by'),
                callback: (value) => value || `<i class="light">${Craft.t('app', 'No usages')}</i>`,
            },
        ];

        new Craft.Discontent.FilterTable({
            columns: columns,
            tableContainer: '#ct-fields-table',
            endpoint: 'discontent/fields/table-data',
            emptyMessage: Craft.t('discontent', 'No fields match these filters.'),
            searchSelector: '#ct-search',
            filterSelector: '#ct-type',
            filterParam: 'type',
            unusedSelector: '#ct-unused',
            editAction: 'fields/edit-field',
            editParam: 'fieldId',
            editIdRegex: /\/fields\/edit\/(\d+)/,
            readOnly: {{ craft.app.config.general.allowAdminChanges ? 'false' : 'true' }},
            {% if craft.app.config.general.allowAdminChanges %}
            deleteAction: 'fields/delete-field',
            {% endif %}
        });
    })();
{% endjs %}
